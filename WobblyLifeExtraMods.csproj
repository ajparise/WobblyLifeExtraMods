<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>WobblyLifeExtraMods</AssemblyName>
    <RootNamespace>WobblyLifeExtraMods</RootNamespace>
    <Version>1.17.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <WobblyLifeDir Condition="'$(WobblyLifeDir)' == '' and '$(OS)' == 'Windows_NT'">C:\Program Files (x86)\Steam\steamapps\common\Wobbly Life</WobblyLifeDir>
    <WobblyLifeDir Condition="'$(WobblyLifeDir)' == ''">/mnt/c/Program Files (x86)/Steam/steamapps/common/Wobbly Life</WobblyLifeDir>
    <ManagedDir>$(WobblyLifeDir)/Wobbly Life_Data/Managed</ManagedDir>
    <BepInExDir>$(WobblyLifeDir)/BepInEx</BepInExDir>
    <LstwoDir>$(BepInExDir)/plugins/lstwoMODS</LstwoDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExDir)/core/BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExDir)/core/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="lstwoMODS_Core">
      <HintPath>$(LstwoDir)/lstwoMODS_Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="lstwoMODS_WobblyLife">
      <HintPath>$(LstwoDir)/lstwoMODS_WobblyLife.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="lstwoMODS.WobblyLife.SharedObjects">
      <HintPath>$(LstwoDir)/lstwoMODS.WobblyLife.SharedObjects.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="lstwoMODS.ImGui.Shared">
      <HintPath>$(LstwoDir)/lstwoMODS.ImGui.Shared.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Game">
      <HintPath>$(ManagedDir)/Game.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ModWobblyLife">
      <HintPath>$(ManagedDir)/ModWobblyLife.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Utils">
      <HintPath>$(ManagedDir)/Utils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HawkNetworking">
      <HintPath>$(ManagedDir)/HawkNetworking.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="FMODUnity">
      <HintPath>$(ManagedDir)/FMODUnity.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ManagedDir)/UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AIModule">
      <HintPath>$(ManagedDir)/UnityEngine.AIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedDir)/UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(ManagedDir)/UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedDir)/UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Addressables">
      <HintPath>$(ManagedDir)/Unity.Addressables.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.ResourceManager">
      <HintPath>$(ManagedDir)/Unity.ResourceManager.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateGameFiles" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(LstwoDir)/lstwoMODS_WobblyLife.dll')"
           Text="lstwoMODS_WobblyLife.dll was not found under $(LstwoDir). Set WobblyLifeDir to the game installation directory." />
  </Target>
</Project>
